# Soterra environment variables, grouped by WHERE each one is set. Never commit real values.

# ─── Convex deployment ──────────────────────────────────────────────────────────
# Set with: npx convex env set NAME value   (Convex functions only see these)
VOICE_API_SECRET=                       # shared with voice/; required (backend rejects all /voice calls without it)
LLM_PROVIDER=mock                       # mock | anthropic
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-5-5      # call turns (verified live 2026-10-24)
CLAUDE_SMART_MODEL=claude-sonnet-5-5    # call summaries and ingestion extraction (verified live 2026-10-24)
CLAUDE_SUMMARY_MODEL=                   # optional override for call summaries (defaults to CLAUDE_SMART_MODEL)
MOCK_LLM_MODE=normal                    # dev/test only: normal | invalid_json | uncited_answer | unknown_chunk | timeout | error
RETRIEVER=convex                        # convex | moss (Moss cannot load in Convex today; it falls back to convex — see docs/backend.md)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=                   # checked on POST /ingest/apify (header X-Soterra-Webhook-Secret or ?secret=)
NWS_USER_AGENT=                         # required by api.weather.gov, e.g. "(soterra-calhacks, you@example.com)"
INGEST_STATES=CA                        # comma-separated USPS codes
PHONE_NOTIFIER=mock                     # mock | cartesia (cartesia is NOT verified live)
CARTESIA_API_KEY=                       # outbound callbacks only
CARTESIA_AGENT_ID=                      # the code agent (soterra-voice): agent_1iwkwy7nwEfejQJzwM75hm
CARTESIA_FROM_NUMBER_ID=                # phone number id (cartesia phone-numbers ls): ap_CWGJppviDa2Ea1jeZEYwBt
SMS_NOTIFIER=unconfigured               # no SMS provider chosen
SERVE_FIXTURES=false                    # true = callers may hear the fictional demo data
ENABLE_MOCK_SITES=false                 # true = serve fixtures/mock-sites at /mock-sites/*
ANON_TRANSCRIPT_TTL_HOURS=168           # turns of anonymous calls (7 days)
ANON_MEMORY_TTL_DAYS=30                 # anonymous caller memory, summaries and call rows
# Ingestion (docs/ingestion.md). All optional; defaults shown.
APIFY_MODE=mock                         # mock | live (live promotes every Apify source to live)
APIFY_MIN_INTERVAL_MIN=5                # Apify sources never run more often, even in crisis mode
APIFY_MAX_ITEMS=50                      # per run (also sent to Apify as maxItems)
APIFY_MAX_CHARGE_USD=0.5                # per run (sent to Apify as maxTotalChargeUsd)
APIFY_MEMORY_MB=2048                    # per run (sent to Apify as memory); the free plan allows 16 GB in total
USGS_MIN_MAGNITUDE=3
X_ALLOWLIST=                            # handle:Issuer Name:CA|OR,handle2:Other Issuer:CA (default: demo handle only)
SIGNAL_BURST_THRESHOLD=3
SIGNAL_BURST_WINDOW_MIN=30
BACKOFF_CAP_MIN=60
RAW_PAYLOAD_TTL_HOURS=24
EXTRACTION_TIMEOUT_MS=20000
EXTRACTION_MAX_CHARS=12000

# ─── Local CLI (.env.local, written by `npx convex dev`) ────────────────────────
# CONVEX_DEPLOYMENT=dev:...
# CONVEX_URL=https://<name>.convex.cloud
# CONVEX_SITE_URL=https://<name>.convex.site      # used by npm run sim:call
# VOICE_API_SECRET=                               # add by hand, same value as the deployment's, for sim:call

# ─── Voice service ─────────────────────────────────────────────────────────────
# See voice/.env.example (voice/.env locally, `cartesia env set` when deployed):
# SOTERRA_BACKEND_URL, VOICE_API_SECRET, BACKEND_MODE=http|mock, DEFAULT_LANGUAGE=en
