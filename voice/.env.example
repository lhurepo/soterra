# [V] Voice service env. Locally: copy to voice/.env. Deployed: `cartesia env set --from .env`.
# http = call the real backend; mock = canned replies (no backend needed).
BACKEND_MODE=http
# The backend's .convex.site URL (CONVEX_SITE_URL in the repo's .env.local).
SOTERRA_BACKEND_URL=https://<your-deployment>.convex.site
# Must equal the Convex deployment's VOICE_API_SECRET (npx convex env get VOICE_API_SECRET).
VOICE_API_SECRET=
DEFAULT_LANGUAGE=en
# Seconds. Fallback after TURN_TIMEOUT_S; one filler line after FILLER_AFTER_S.
TURN_TIMEOUT_S=8
FILLER_AFTER_S=1.6
END_SESSION_TIMEOUT_S=2
MAX_CONSECUTIVE_FAILURES=3
# Sonic voices (Cartesia voice library). VOICE_ID_ES defaults to VOICE_ID_EN (voices are multilingual).
VOICE_ID_EN=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
VOICE_ID_ES=
TTS_MODEL=sonic-3.6
PRONUNCIATION_DICT_ID=
# Our own Cartesia number(s): a call FROM one of these is an outbound callback.
SOTERRA_PHONE_NUMBERS=+18046066867
# Dialed number → language, e.g. a dedicated Spanish line: +14155550100:es
LANGUAGE_BY_DIALED_NUMBER=
# Say "Para español, oprima dos." after the English greeting (keypad 2/1 switch works either way).
OFFER_SPANISH_DTMF=false
# Mock mode only: replay a scripted call, e.g. ../fixtures/conversations/ridgeview-basic.json
MOCK_CONVERSATION=
